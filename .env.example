# CHAINVISION — root .env.example
# Placeholder values only. Never commit real secrets.
# DB is Supabase-hosted (no local postgres container) — see 00_PROJECT_CONTEXT.md Architecture Note.

# --- Supabase (shared by p1-backend and pr2-backend) ---
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=replace_with_supabase_anon_key
# SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key

# --- P1 backend (Node/Express) ---
# Required by the P1 foundation; provide real values in the local .env only.
# P1_PORT=4000
# JWT_SECRET=replace_with_shared_secret
# PR2_BASE_URL=http://pr2-backend:8080
# INTERNAL_API_KEY=replace_with_internal_service_key
# INTERNAL_REALTIME_KEY=replace_with_internal_key

# --- PR2 backend (Java/Spring Boot) ---
# Supabase Postgres URL should include `currentSchema=pr2&sslmode=require`.
# PR2_PORT=8080
# SPRING_DATASOURCE_URL=jdbc:postgresql://your-db-host:5432/postgres?currentSchema=pr2&sslmode=require
# SPRING_DATASOURCE_USERNAME=postgres.your-project-ref
# SPRING_DATASOURCE_PASSWORD=replace_with_supabase_database_password
# JWT_SECRET=replace_with_shared_secret   # must match P1's value
# P1_BASE_URL=http://p1-backend:4000
# P1_REALTIME_URL=http://p1-backend:4000/internal/realtime/emit
# INTERNAL_REALTIME_KEY=replace_with_internal_key  # must match P1's value

# --- AI (Google Gemini) ---
# GEMINI_API_KEY=replace_with_gemini_api_key
# GEMINI_MODEL=gemini-2.0-flash

# --- Frontend ---
# VITE_P1_API_BASE=http://localhost:4000/api
# VITE_PR2_API_BASE=http://localhost:8080/api
# VITE_SOCKET_URL=http://localhost:4000
